{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pea-tracker-financial-read",
  "main": "../../src/entrypoints/access-read.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "d1_databases": [{
    "binding": "INSTRUMENTS_DB",
    "database_name": "pea-tracker-quotes-ingestion",
    "database_id": "REPLACE_WITH_EXISTING_D1_ID",
    "remote": false,
    "migrations_dir": "../../migrations"
  }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_READ_AUD": "REPLACE_WITH_DISTINCT_READ_APPLICATION_AUD",
    "ACCESS_READ_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
