{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pea-tracker-instruments-local",
  "main": "../../src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "INSTRUMENTS_DB",
      "database_name": "pea-tracker-instruments-local",
      "remote": false,
      "migrations_dir": "../../migrations"
    }
  ]
}
